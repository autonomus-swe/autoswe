.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.adlc/session/
# Eval results are the numbers the project quotes about itself, so they belong in the
# repository — this used to ignore the whole directory, which hid the README the CHANGELOG
# and both phase documents point at. Scratch runs go to AUTOSWE_EVAL_RESULTS instead.
evals/results/*.tmp
# scripts/bringup.sh keeps the API and worker pids and their logs here
.run/
dist/
build/
*.egg-info/

# Which external MCP servers this deployment mounts. Per-deployment, and its `env`
# block names the variables a mounted server is handed. `mcp_servers.yaml.example` is
# the version that is committed.
mcp_servers.yaml
