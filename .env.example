# ---- Phase 0 (required) ----
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/autoswe
REDIS_URL=redis://localhost:6379/0
API_KEYS=dev-key-change-me
# ---- Phase 1+ (worker only) ----
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
WORKTREES_DIR=/var/agent/worktrees
REPOS_DIR=/var/agent/repos
SANDBOX_IMAGE=agent-sandbox:python-3.12
# ---- docker compose host ports (change if 5432/6379 are taken locally) ----
POSTGRES_PORT=5432
REDIS_PORT=6379
# ---- misc ----
ENVIRONMENT=dev
LOG_LEVEL=INFO
