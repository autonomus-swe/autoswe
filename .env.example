# ---- Phase 0 (required) ----
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/autoswe
REDIS_URL=redis://localhost:6379/0
API_KEYS=dev-key-change-me
# ---- Phase 1+ (worker only) ----
# LLM: any OpenAI-compatible endpoint. Default is OpenRouter (https://openrouter.ai/keys).
# Free tool-capable models seen there: minimax/minimax-m3:free, minimax/minimax-m2.7:free,
# openrouter/free (auto-router), nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-31b-it:free
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=minimax/minimax-m3:free
LLM_MAX_TOKENS=16000
ANTHROPIC_API_KEY=
# GitHub token with Contents + Pull requests read/write on the repos the agent works on
GITHUB_TOKEN=
# Production: /var/agent/{worktrees,repos} owned by the worker user. Local dev: any writable dir.
WORKTREES_DIR=/var/agent/worktrees
REPOS_DIR=/var/agent/repos
SANDBOX_IMAGE=agent-sandbox:python-3.12
SANDBOX_NETWORK=agent-install
# Sandbox runs as SANDBOX_UID:SANDBOX_GID (defaults to the worker's own uid/gid)
#SANDBOX_UID=1000
#SANDBOX_GID=1000
KEEP_FAILED_SANDBOX=false
# ---- docker compose host ports (change if 5432/6379 are taken locally) ----
POSTGRES_PORT=5432
REDIS_PORT=6379
# ---- misc ----
ENVIRONMENT=dev
LOG_LEVEL=INFO
